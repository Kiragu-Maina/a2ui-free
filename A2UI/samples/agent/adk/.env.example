# Copy to `.env` in the directory of the sample you're running.
# All A2UI ADK samples now resolve their model through samples/agent/adk/_shared/model_factory.py.

# ---------------------------------------------------------------------------
# Primary control: a single env var of the form  provider/model-id
# ---------------------------------------------------------------------------
# Examples:
#   LLM_MODEL=gemini/gemini-2.5-flash
#   LLM_MODEL=cloudflare/@cf/meta/llama-3.3-70b-instruct-fp8-fast
#   LLM_MODEL=openai/gpt-4o-mini
#   LLM_MODEL=anthropic/claude-haiku-4-5-20251001
#   LLM_MODEL=ollama_chat/llama3.1
LLM_MODEL=gemini/gemini-2.5-flash

# Optional overrides applied to LiteLLM-routed providers (cloudflare, openai, ...).
# Native Gemini ignores these and uses GOOGLE_API_KEY / ADC.
# LLM_API_KEY=
# LLM_API_BASE=

# ---------------------------------------------------------------------------
# Provider-specific credentials
# ---------------------------------------------------------------------------

# Gemini (native, via google-genai)
# GOOGLE_API_KEY=...
# or use Vertex AI:
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=...
# GOOGLE_CLOUD_LOCATION=us-central1

# Cloudflare Workers AI
# Required when LLM_MODEL starts with `cloudflare/`.
# Token needs the "Workers AI" permission. Account ID is on the CF dashboard home.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
#
# Recommended free-tier models for A2UI (need tool/JSON support):
#   @cf/meta/llama-3.3-70b-instruct-fp8-fast
#   @cf/meta/llama-4-scout-17b-16e-instruct
#   @cf/nousresearch/hermes-2-pro-mistral-7b
#   @cf/openai/gpt-oss-20b

# NVIDIA NIM (free perpetual tier)
# Required when LLM_MODEL starts with `nvidia/`. Model ids include the org
# prefix verbatim, e.g. nvidia/meta/llama-3.3-70b-instruct.
# NVIDIA_NIM_API_KEY=
#
# Recommended free NVIDIA models (40 rpm / 5000 rpd, 131k context):
#   meta/llama-4-maverick-17b-128e-instruct      (high quality, fast)
#   meta/llama-3.3-70b-instruct                  (high quality, medium)
#   deepseek-ai/deepseek-v3.2                    (high quality, medium)
#   moonshotai/kimi-k2-instruct                  (high quality, medium)
#   qwen/qwen3-coder-480b-a35b-instruct          (code/reasoning specialist)
#   mistralai/mistral-large-3-675b-instruct-2512 (high quality, slow)

# OpenAI
# OPENAI_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Council mode (LLM_MODEL=council/<strategy>)
# ---------------------------------------------------------------------------
# Fans each request out to N child models in parallel, then reduces.
# Strategies: single-query, ranked-fallback, majority-vote, synthesize-best
#
# Best for the JSON-generation step. Do NOT use council mode for agents that
# rely heavily on tool calling -- voting across function-call responses is
# undefined. Use a single model for tool steps, council for the UI step.
#
# Example: 3 free providers, synthesize via a fourth as judge.
# LLM_MODEL=council/synthesize-best
# COUNCIL_MODELS=cloudflare/@cf/meta/llama-3.3-70b-instruct-fp8-fast,cloudflare/@cf/openai/gpt-oss-20b,cloudflare/@cf/nousresearch/hermes-2-pro-mistral-7b
# COUNCIL_JUDGE=gemini/gemini-2.5-flash
#
# Or pure free-CF council with no judge (judge defaults to first child):
# LLM_MODEL=council/majority-vote
# COUNCIL_MODELS=cloudflare/@cf/meta/llama-3.3-70b-instruct-fp8-fast,cloudflare/@cf/meta/llama-4-scout-17b-16e-instruct,cloudflare/@cf/openai/gpt-oss-20b
#
# Mixed free council across providers (CF + NVIDIA), self-judging:
# LLM_MODEL=council/synthesize-best
# COUNCIL_MODELS=cloudflare/@cf/meta/llama-3.3-70b-instruct-fp8-fast,nvidia/meta/llama-4-maverick-17b-128e-instruct,nvidia/deepseek-ai/deepseek-v3.2
# COUNCIL_JUDGE=nvidia/moonshotai/kimi-k2-instruct
#
# Pure NVIDIA council (all high-quality, single API key):
# LLM_MODEL=council/majority-vote
# COUNCIL_MODELS=nvidia/meta/llama-3.3-70b-instruct,nvidia/meta/llama-4-maverick-17b-128e-instruct,nvidia/deepseek-ai/deepseek-v3.2

# ---------------------------------------------------------------------------
# Auto council (LLM_MODEL=auto/<strategy>)
# ---------------------------------------------------------------------------
# Builds a diversified council from samples/agent/adk/_shared/discovered_models.json.
# The probe (discover_free_models.py) is intended to run weekly via cron and
# refresh the manifest with whichever providers/models are currently live and
# free on your keys -- no code change needed when providers rotate models.
#
# Picks 1 model per provider round-robin (fastest first), capped at COUNCIL_SIZE.
#
# LLM_MODEL=auto/synthesize-best
# COUNCIL_SIZE=3
# COUNCIL_PROVIDERS=nvidia,groq,cerebras       # optional allow-list
# COUNCIL_JUDGE=gemini/gemini-2.5-flash         # optional, defaults to first child
# DISCOVERED_MODELS_PATH=./discovered_models.json  # optional override
#
# RESILIENT mode -- "almost always get a result":
# Tries up to COUNCIL_SIZE (default 15) live models sequentially, skipping
# any quarantined by recent rate-limits / 5xx failures. With ~90 live free
# models across providers, this should survive most provider outages.
# LLM_MODEL=auto/resilient
# COUNCIL_SIZE=20                              # how many models to try max
# COUNCIL_PROVIDERS=nvidia,groq,cerebras,mistral   # spread across providers

# ---------------------------------------------------------------------------
# Hybrid mode (LLM_MODEL=hybrid/<strategy>)
# ---------------------------------------------------------------------------
# Tool-decision turns -> TOOL_MODEL (single, tool-capable model).
# Post-tool generation turns -> auto-pool council with the given strategy
# (default "resilient"). Use this for agents like restaurant_finder where one
# model decides function calls and the other produces the final UI JSON.
#
# LLM_MODEL=hybrid/resilient
# TOOL_MODEL=nvidia/meta/llama-3.3-70b-instruct  # tool-capable, deterministic
# COUNCIL_SIZE=10
# COUNCIL_PROVIDERS=nvidia,groq,cerebras,mistral
#
# *** RECOMMENDED DEFAULT for A2UI agents (verified passing end-to-end against
# restaurant_finder with first-attempt schema validation): ***
#
# LLM_MODEL=hybrid/synthesize-best
# TOOL_MODEL=nvidia/meta/llama-3.3-70b-instruct
# COUNCIL_JUDGE=nvidia/meta/llama-3.3-70b-instruct  # judge cleans up reasoning
# COUNCIL_SIZE=3
# COUNCIL_PROVIDERS=nvidia,groq,cerebras,mistral
#
# Why: small/fast free models (Cerebras gpt-oss-120b, Groq qwen3-32b) often emit
# visible reasoning tokens or skip the <a2ui-json> tag wrapper that the A2UI
# parser requires. The synthesize-best judge (NVIDIA Llama 3.3 70B) re-formats
# the candidates into clean tag-wrapped JSON that passes the schema validator
# on the first attempt. The factory's synthesize-best judge prompt explicitly
# instructs the judge to preserve the original tag/code-fence wrapping.

# ---------------------------------------------------------------------------
# Legacy variables (still honored as fallbacks, prefer LLM_MODEL above)
# ---------------------------------------------------------------------------
# LITELLM_MODEL=gemini/gemini-2.5-flash
# MODEL_NAME=gemini-2.5-flash
# MODEL=gemini-2.5-flash
