# Copy to .env in this directory before `docker compose up`.
# All values default to sensible production values; uncomment to override.

# Public-facing URLs. Override when deploying to a staging domain.
# PUBLIC_URL=https://a2ui-free.alkenacode.dev/agent
# PUBLIC_AGENT_URL=https://a2ui-free.alkenacode.dev/agent
# CORS_ORIGIN=^https://a2ui-free\.alkenacode\.dev$

# LLM_MODEL routing (see A2UI/samples/agent/adk/.env.example for full reference).
# LLM_MODEL=hybrid/synthesize-best
# TOOL_MODEL=nvidia/meta/llama-3.3-70b-instruct
# COUNCIL_JUDGE=nvidia/meta/llama-3.3-70b-instruct
# COUNCIL_SIZE=3
# COUNCIL_PROVIDERS=nvidia,groq,cerebras,mistral

# Free-tier provider keys. All optional; the council degrades gracefully if a
# provider key is missing or expired (the model is quarantined for 60-300s).
GOOGLE_AI_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
NVIDIA_NIM_API_KEY=
